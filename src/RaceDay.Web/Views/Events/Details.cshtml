@model EventDetailsPage
@{
    ViewData["Title"] = Model.Event?.EventName ?? "Event";
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Event is not null)
{
    <p><a asp-action="Index">&larr; All events</a></p>
    <section class="simple-card mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
        {
            <img class="event-banner mb-4" src="@Model.Event.BannerImageUrl" alt="Banner for @Model.Event.EventName" />
        }
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div>
                <span class="badge text-bg-light">@Model.Event.EventType</span>
                <h1 class="mt-3">@Model.Event.EventName</h1>
            </div>
            <div class="event-date">@Model.Event.EventDate.ToString("dd MMM yyyy")</div>
        </div>
        <p class="lead">@Model.Event.Description</p>
        <p class="mb-0">@Model.Event.Location · @Model.Event.DistanceKm km</p>
    </section>
    <h2 class="h3 mb-3">Categories</h2>
    @if (Model.Event.Categories.Count == 0)
    {
        <div class="simple-card">No categories have been added to this event yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var category in Model.Event.Categories)
            {
                <div class="col-md-6">
                    <article class="event-card">
                        <h3 class="h5">@category.CategoryName</h3>
                        <p>Entry fee: R @category.EntryFee.ToString("N2")</p>
                        <p class="text-secondary">@category.Enrolled of @category.MaxParticipants places filled</p>
                        @if (User.IsInRole("Participant"))
                        {
                            <form asp-action="Enrol" method="post">
                                <input type="hidden" name="eventCategoryId" value="@category.EventCategoryID" />
                                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                <button class="btn btn-success" type="submit" disabled="@(category.Enrolled >= category.MaxParticipants)">Enrol</button>
                            </form>
                        }
                        @if (User.IsInRole("Organiser") && Model.Event.OrganiserID == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <a class="btn btn-outline-success btn-sm" asp-controller="Organiser" asp-action="Categories" asp-route-id="@Model.Event.EventID">Manage categories</a>
                        }
                    </article>
                </div>
            }
        </div>
    }
}
