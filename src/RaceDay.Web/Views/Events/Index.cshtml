@model EventListPage
@{
    ViewData["Title"] = "Events";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="eyebrow mb-1">RaceDay calendar</p>
        <h1 class="mb-0">Upcoming events</h1>
    </div>
    @if (User.IsInRole("Organiser"))
    {
        <a class="btn btn-success" asp-controller="Organiser" asp-action="CreateEvent">Create event</a>
    }
</div>
<form method="get" class="filter-bar mb-4">
    <div>
        <label for="search" class="form-label">Search events</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event or location" />
    </div>
    <div>
        <label for="eventType" class="form-label">Event type</label>
        <select id="eventType" name="eventType" class="form-select">
            <option value="">All types</option>
            <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
            <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
            <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
        </select>
    </div>
    <button class="btn btn-outline-secondary align-self-end" type="submit">Filter</button>
</form>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Events.Count == 0)
{
    <div class="simple-card empty-state">
        <h2>No upcoming events found</h2>
        <p>Try another search or check back later.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <article class="event-card h-100">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="badge text-bg-light">@item.EventType</span>
                        <span class="text-secondary small">@item.EventDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <h2 class="h4 mt-3">@item.EventName</h2>
                    <p class="text-secondary mb-2">@item.Location · @item.DistanceKm km</p>
                    <p class="flex-grow-1">@item.Description</p>
                    <a class="btn btn-outline-success" asp-action="Details" asp-route-id="@item.EventID">View event</a>
                </article>
            </div>
        }
    </div>
}
