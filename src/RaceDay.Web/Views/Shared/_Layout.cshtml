@using System.Security.Claims
@{
    var role = User.FindFirstValue(ClaimTypes.Role);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RaceDay</a>
        <div class="navbar-nav me-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                @if (role == "Organiser")
                {
                    <a class="nav-link" asp-controller="Organiser" asp-action="Index">My events</a>
                }
                @if (role == "Participant")
                {
                    <a class="nav-link" asp-controller="Participant" asp-action="Enrolments">My enrolments</a>
                    <a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a>
                }
                <a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="small text-secondary d-none d-md-inline">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="btn btn-success btn-sm" asp-controller="Account" asp-action="Register">Create account</a>
            }
        </div>
    </nav>
</header>
<main class="container page-content">
    @if (TempData["Notice"] is string notice)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @RenderBody()
</main>
<footer class="container py-4 text-secondary small">RaceDay event management</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
